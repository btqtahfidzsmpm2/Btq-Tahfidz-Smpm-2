        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nama": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["guru_ngaji", "guru_tahfidz", "wali_kelas"]
        },
        "kelompokBTQ": {
          "type": "string",
          "maxLength": 200
        },
        "kelompokTahfidz": {
          "type": "string",
          "maxLength": 200
        },
        "assignedClass": {
          "type": "string",
          "maxLength": 30
        },
        "ruangan": {
          "type": "string",
          "maxLength": 100
        },
        "kontak": {
          "type": "string",
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "nama", "role", "kelompokBTQ", "ruangan", "createdAt", "updatedAt"]
    },
    "AccessRequest": {
      "title": "AccessRequest",
      "description": "Pending request from a Google-authenticated teacher asking Admin to link their account.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150
        },
        "nama": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "requestedRole": {
          "type": "string",
          "enum": ["guru_ngaji", "guru_tahfidz", "wali_kelas"]
        },
        "requestedNote": {
          "type": "string",
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "nama", "requestedRole", "requestedNote", "status", "createdAt", "updatedAt"]
    },
    "StudentRecord": {
