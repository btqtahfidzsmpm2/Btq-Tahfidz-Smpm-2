{
  "entities": {
    "AdminDoc": {
      "title": "AdminDoc",
      "description": "Administrator registry document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150
        },
        "nama": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "nama", "createdAt"]
    },
    "StaffUser": {
      "title": "StaffUser",
      "description": "Authenticated staff profile linking a verified Google account to a role and class scope.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150
        },
        "nama": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["admin", "guru_ngaji", "guru_tahfidz", "wali_kelas"]
        },
        "teacherId": {
          "type": "string",
          "maxLength": 128
        },
        "assignedGroup": {
          "type": "string",
          "maxLength": 200
        },
        "assignedTahfidzGroup": {
          "type": "string",
          "maxLength": 200
        },
        "assignedClass": {
          "type": "string",
          "maxLength": 30
        },
        "isActive": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "nama", "role", "isActive", "createdAt", "updatedAt"]
    },
    "StaffDirectoryItem": {
      "title": "StaffDirectoryItem",
      "description": "Teacher and Wali Kelas directory entry managed by Admin.",
