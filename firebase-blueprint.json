          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "gender": {
          "type": "string",
          "enum": ["L", "P"]
        },
        "kelas": {
          "type": "string",
          "maxLength": 30
        },
        "kelasBTQ": {
          "type": "string",
          "maxLength": 120
        },
        "pengajar": {
          "type": "string",
          "maxLength": 120
        },
        "ruangan": {
          "type": "string",
          "maxLength": 100
        },
        "waliKelas": {
          "type": "string",
          "maxLength": 120
        },
        "isTahfidz": {
          "type": "boolean"
        },
        "pembimbingTahfidz": {
          "type": "string",
          "maxLength": 120
        },
        "halaqahTahfidz": {
          "type": "string",
          "maxLength": 120
        },
        "ruanganTahfidz": {
          "type": "string",
          "maxLength": 100
        },
        "targetJuz": {
          "type": "string",
          "maxLength": 80
        },
        "totalHafalan": {
          "type": "string",
          "maxLength": 100
        },
        "hafalanTerakhir": {
          "type": "string",
          "maxLength": 150
        },
        "capaianTerakhir": {
          "type": "object"
        },
        "ujian": {
          "type": "object"
        },
        "kehadiranPersen": {
          "type": "number"
        },
        "authorizedEmails": {
          "type": "array"
        },
        "editorEmails": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "nisn",
        "nama",
        "gender",
        "kelas",
        "kelasBTQ",
        "pengajar",
        "ruangan",
        "waliKelas",
        "isTahfidz",
        "capaianTerakhir",
        "ujian",
        "authorizedEmails",
        "editorEmails",
        "createdAt",
        "updatedAt"
      ]
    },
    "BacaanRecordDoc": {
