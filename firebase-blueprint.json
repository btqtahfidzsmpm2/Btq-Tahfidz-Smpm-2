    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminDoc" },
      "description": "Verified administrator UID registry."
    },
    "/staffUsers/{uid}": {
      "schema": { "$ref": "#/entities/StaffUser" },
      "description": "Authenticated staff member profile and role assignment."
    },
    "/staffDirectory/{staffId}": {
      "schema": { "$ref": "#/entities/StaffDirectoryItem" },
      "description": "Teacher and homeroom teacher directory managed by Admin."
    },
    "/accessRequests/{uid}": {
      "schema": { "$ref": "#/entities/AccessRequest" },
      "description": "Teacher/staff account linkage requests awaiting Admin approval."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/StudentRecord" },
      "description": "Real-time student records scoped by authorizedEmails & editorEmails."
    },
    "/bacaan/{recordId}": {
      "schema": { "$ref": "#/entities/BacaanRecordDoc" },
      "description": "Real-time Tilawati and Al-Qur'an progress records."
    },
    "/tahfidz/{recordId}": {
      "schema": { "$ref": "#/entities/TahfidzRecordDoc" },
      "description": "Real-time Tahfidz memorization records."
    },
    "/absensi/{recordId}": {
      "schema": { "$ref": "#/entities/AbsensiRecordDoc" },
      "description": "Real-time daily attendance records."
    },
    "/raporConfig/{configId}": {
      "schema": { "$ref": "#/entities/RaporSettingsDoc" },
      "description": "Global rapor header and signatory settings."
    },
    "/raporStatuses/{nisn}": {
      "schema": { "$ref": "#/entities/RaporPrintStatusDoc" },
      "description": "Admin-only rapor print status per student."
    },
    "/raporLogs/{logId}": {
      "schema": { "$ref": "#/entities/RaporPrintBatchLogDoc" },
      "description": "Admin-only batch report print and PDF download logs."
    },
    "/publicReports/{nisn}": {
      "schema": { "$ref": "#/entities/PublicReportDoc" },
      "description": "Exact-NISN parent lookup report summary (get-only, no list)."
    }
  }
}
